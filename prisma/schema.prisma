generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
model Analysis {
  id        String   @id @default(cuid())
  url       String?
  title     String
  rawText   String
  result    Json
  createdAt DateTime @default(now())
  createdBy String?  @map("created_by")

  @@index([createdBy, createdAt])
}